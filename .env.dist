# Local development settings for `task dev`. `synclet generate dotenv` appends
# every other variable the binary reads, with its default.
ENVIRONMENT=development
LOG_LEVEL=debug
DB_DSN=postgres://synclet:synclet@localhost:5432/synclet?sslmode=disable

# The Vite dev server proxies API calls to :8086.
PUBLIC_HTTP_SERVER_ADDR=0.0.0.0:8086
INTERNAL_HTTP_SERVER_ADDR=0.0.0.0:8087

# MCP endpoint for AI clients, served at /mcp on its own server.
# MCP_ENABLED=true
MCP_HTTP_SERVER_ADDR=0.0.0.0:8082
# Base URL AI clients reach the MCP server at; OAuth discovery and tokens are served there.
# MCP_PUBLIC_URL=http://localhost:8082
# Base URL of the UI serving the OAuth consent page; empty takes AUTH_OIDC_CALLBACK_BASE_URL.
# MCP_UI_URL=http://localhost:5173

# Required outside development. In development, leaving them unset generates an
# ephemeral JWT secret and a persisted encryption key under the user config
# directory. Generate each with `openssl rand -base64 32`.
# AUTH_JWT_SECRET: any string of at least 32 bytes.
# SECRET_ENCRYPTION_KEY: a standard base64-encoded 32-byte key.
# The server refuses to start when either does not match its format.
# AUTH_JWT_SECRET=
# SECRET_ENCRYPTION_KEY=

# Open self-registration. While off, sign-up stays open until the first
# account exists.
AUTH_REGISTRATION_ENABLED=false
AUTH_SECURE_COOKIES=false
# Minimum time between two password reset emails for the same user.
AUTH_PASSWORD_RESET_COOLDOWN=2m

# Comma-separated IPs or CIDRs of reverse proxies (e.g. the ingress controller)
# whose X-Forwarded-For / X-Real-IP headers name the client for login and
# register rate limits. Empty: limits key on the TCP peer.
# RATE_LIMIT_TRUSTED_PROXIES=

WORKSPACE_MODE=single
WORKSPACE_FRONTEND_URL=http://localhost:5173

# Email delivery for invites, password resets and notifications. Leave
# NOTIFY_SMTP_HOST empty to disable email; invite links can still be copied from
# the members page. The values below send everything to Mailpit
# (`docker compose -f docker-compose.dev.yml up -d mailpit`); read the mail at
# http://localhost:8025.
NOTIFY_SMTP_HOST=localhost
NOTIFY_SMTP_PORT=1025
# implicit (TLS from the first byte, usually port 465), starttls (usually port
# 587) or none (plain text, local catchers only).
NOTIFY_SMTP_TLS=none
# NOTIFY_SMTP_USER=
# NOTIFY_SMTP_PASSWORD=
# NOTIFY_SMTP_FROM=noreply@synclet.io

AUDIT_RETENTION_DAYS=90
AUDIT_RETENTION_MAX_DAYS=365
AUDIT_RETENTION_CLEANUP_INTERVAL=1h

# Event consumers: a failing handler is retried with exponential backoff
# (1s, 2s, 4s, ... capped at MAX_INTERVAL); after MAX_RETRIES the message is
# moved to the events.dead_letter topic and acked.
EVENTS_RETRY_MAX_RETRIES=5
EVENTS_RETRY_INITIAL_INTERVAL=1s
EVENTS_RETRY_MAX_INTERVAL=1m

# Job logs. Lines beyond the per-attempt cap are dropped and counted in one
# marker line (0 = no cap).
# PIPELINE_LOG_MAX_LINES_PER_ATTEMPT=100000
# Where logs of finished jobs go: none (stay in Postgres), filesystem, s3 or gcs.
# PIPELINE_LOG_ARCHIVE_BACKEND=none
# Base directory for the filesystem backend.
# PIPELINE_LOG_ARCHIVE_DIR=./data/job-logs
# S3-compatible endpoint; empty for AWS S3 (e.g. http://localhost:9000 for MinIO).
# PIPELINE_LOG_ARCHIVE_S3_ENDPOINT=
# Bucket region; R2 uses "auto". Falls back to AWS_REGION.
# PIPELINE_LOG_ARCHIVE_S3_REGION=
# Bucket that holds the archives.
# PIPELINE_LOG_ARCHIVE_S3_BUCKET=
# Key prefix inside the bucket.
# PIPELINE_LOG_ARCHIVE_S3_PREFIX=
# Static credentials; leave both empty to use the default AWS credential chain.
# PIPELINE_LOG_ARCHIVE_S3_ACCESS_KEY_ID=
# PIPELINE_LOG_ARCHIVE_S3_SECRET_ACCESS_KEY=
# Path-style addressing (bucket in the path), needed by MinIO and most self-hosted stores.
# PIPELINE_LOG_ARCHIVE_S3_USE_PATH_STYLE=false
# Google Cloud Storage bucket for the gcs backend.
# PIPELINE_LOG_ARCHIVE_GCS_BUCKET=
# Object name prefix inside the bucket.
# PIPELINE_LOG_ARCHIVE_GCS_PREFIX=
# Service account JSON key; empty uses Application Default Credentials (GKE Workload Identity, gcloud ADC).
# PIPELINE_LOG_ARCHIVE_GCS_CREDENTIALS_FILE=

# Owner label on Docker connector containers; orphan cleanup removes only its own. Required: a process running
# the Docker executor does not start while it is empty. Set an id unique to this checkout among those sharing
# the Docker daemon (equal ids remove each other's running containers), and keep it stable across restarts.
# docker compose reads it from .env too and falls back to "synclet" when it is empty.
DOCKER_EXECUTOR_OWNER_ID=

# Host directory mounted read-write at /local in every Docker connector container, where file-writing
# destinations (duckdb, csv, local-json, sqlite) leave their files: a destination path of /local/x.duckdb
# lands at <root>/x.duckdb. Shared by all jobs and connectors and never cleaned; a destination's path keeps
# connections apart. Empty gives each job its own /local, removed with the job. A containerised executor
# needs the same path mounted from the host, like DOCKER_EXECUTOR_TEMP_DIR_ROOT (docker-compose.yml uses
# /tmp/synclet_local and makes it 1777). The directory must be writable by the connector images' user; a
# root Synclet creates is made 1777 (sticky, like /tmp), and an existing one keeps its permissions (Synclet
# logs a warning at startup when it is not writable by others).
# DOCKER_EXECUTOR_LOCAL_ROOT=

# Owner label on the Kubernetes executor's Jobs and Secrets; it reconciles and removes only its own.
# Required: the Kubernetes executor does not start without it or K8S_EXECUTOR_OWNER_ID_PREFIX.
# Unique per executor sharing one namespace: equal values remove each other's Jobs. The Helm chart sets it.
# K8S_EXECUTOR_OWNER_ID=

# Owner id prefix for StatefulSet replicas: the owner id is <prefix>-<n>, n the digits after the last "-"
# of the hostname (the pod's ordinal). Startup fails when the hostname does not end in -<digits>, or
# when K8S_EXECUTOR_OWNER_ID is set too.
# K8S_EXECUTOR_OWNER_ID_PREFIX=

# Existing PersistentVolumeClaim mounted read-write at /local in the Kubernetes connector containers,
# where file-writing destinations leave their files. Empty mounts a per-pod emptyDir, removed with the pod.
# The Helm chart sets it from k8s.localVolume.
# K8S_EXECUTOR_LOCAL_VOLUME_CLAIM=
