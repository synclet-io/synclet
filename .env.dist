ENVIRONMENT=development
LOG_LEVEL=debug
DSN=postgres://synclet:synclet@localhost:5432/synclet?sslmode=disable
HTTP_SERVER_ADDR=0.0.0.0:8080

AUDIT_RETENTION_DAYS=90
AUDIT_RETENTION_MAX_DAYS=365
AUDIT_RETENTION_CLEANUP_INTERVAL=1h

# Event consumers: a failing handler is retried with exponential backoff
# (1s, 2s, 4s, ... capped at MAX_INTERVAL); after MAX_RETRIES the message is
# moved to the events.dead_letter topic and acked.
EVENTS_RETRY_MAX_RETRIES=5
EVENTS_RETRY_INITIAL_INTERVAL=1s
EVENTS_RETRY_MAX_INTERVAL=1m
