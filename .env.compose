# Default secrets for the docker-compose.yml quickstart. Anyone with this
# repository knows them: before exposing Synclet beyond localhost, set both in
# an untracked .env next to docker-compose.yml, which overrides this file, to
# the output of `openssl rand -base64 32`. Losing SECRET_ENCRYPTION_KEY makes
# stored connector secrets unreadable.
AUTH_JWT_SECRET=synclet-compose-default-jwt-secret-change-me
SECRET_ENCRYPTION_KEY=c3luY2xldC1jb21wb3NlLWRlZmF1bHQta2V5LTMyYiE=
